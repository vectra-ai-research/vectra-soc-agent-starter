# Vectra AI tenant credentials — copy to `.env` (or `~/.vectra/credentials.env`) and fill in.
# The skill never logs secrets, but the .env file is gitignored to keep them off your branch.
#
# Do NOT commit real values back into this file. Placeholders only.

# Base URL for your Vectra tenant API (no trailing slash).
# Example: https://acme.cc1.portal.vectra.ai/api/v3.4
VECTRA_BASE_URL=

# OAuth2 client credentials (generate from your tenant's API Clients page).
VECTRA_CLIENT_ID=
VECTRA_CLIENT_SECRET=

# Optional: override the OAuth token endpoint (defaults to <base>/oauth2/token derived from VECTRA_BASE_URL).
# VECTRA_OAUTH_TOKEN_URL=

# Optional: tune API rate limit (5 requests / 60 seconds is the documented limit on the
# Investigation Query endpoint and the safe default).
# VECTRA_RATE_LIMIT_REQUESTS=5
# VECTRA_RATE_LIMIT_PERIOD_SEC=60
