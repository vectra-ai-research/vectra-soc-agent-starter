# ──────────────────────────────────────────────────────────────────────────────
# Vectra Skills — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values.
# The .env file is gitignored — credentials never leave your machine.
#
# Search order: cwd → skill directory → ~/.vectra/credentials.env

# ─── Vectra AI Tenant (required) ─────────────────────────────────────────────

# Base URL for your Vectra tenant API (no trailing slash).
# Example: https://acme.cc1.portal.vectra.ai/api/v3.4
VECTRA_BASE_URL=

# OAuth2 client credentials (generate from your tenant's API Clients page).
VECTRA_CLIENT_ID=
VECTRA_CLIENT_SECRET=

# ─── Vectra AI Tenant (optional) ─────────────────────────────────────────────

# Override the OAuth token endpoint (defaults to <base host>/oauth2/token).
# VECTRA_OAUTH_TOKEN_URL=

# Tune API rate limit (5 req / 60s is the documented ceiling for Investigation
# Query and the safe default).
# VECTRA_RATE_LIMIT_REQUESTS=5
# VECTRA_RATE_LIMIT_PERIOD_SEC=60

# ─── VirusTotal (optional — used by the `virustotal` skill) ──────────────────

# API key for VirusTotal v3. Public (free) keys are rate-limited to 4 req/min,
# 500 req/day, ~15.5K req/month. Premium keys raise that ceiling per contract.
# Generate one at https://www.virustotal.com/gui/my-apikey
# VT_API_KEY=

# ─── Adapter HTTP timeout (optional — shared across enrichment adapters) ─────

# Per-request curl --max-time, in seconds. Read by the VirusTotal adapter
# (skills/virustotal/scripts/virustotal.sh) and any future IOC-enrichment
# adapter that follows the same contract. Default 30s when unset.
# TIMEOUT_OVERRIDE=30
